# ⚙️ Severino Engine — variáveis de ambiente (exemplo)
# Copie para `.env` e preencha localmente. NUNCA commite o `.env` real.

# Porta HTTP do engine
ENGINE_PORT=3100

# Diretório das salas (vazio = automático)
ROOMS_DIR=

# Modelo padrão do motor (via 9router)
SEVERINO_MODEL=Tech

# Chave da 9router — coloque sua chave, sem ela o motor responde MOCK
NINEROUTER_API_KEY=

# Base da API 9router (padrão local)
NINEROUTER_BASE_URL=http://localhost:20128/v1

# Token do bot do Telegram (opcional)
TELEGRAM_BOT_TOKEN=
