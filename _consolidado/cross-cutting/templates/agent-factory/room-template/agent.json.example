{
  "id": "robot-backend-001",
  "role": "backend",
  "version": "1.0.0",
  "name": "Backend Engineer Bot",
  "description": "Especialista em APIs, bancos, webhooks, autenticação, performance Node.js/TypeScript",
  "model": "openrouter/anthropic/claude-3.5-sonnet",
  "capabilities": [
    "github-cli",
    "npm-scripts",
    "database-migrate",
    "stripe-cli",
    "docker-compose",
    "skill:fastify-route-template",
    "skill:fastify-webhook-stripe",
    "skill:zod-validation-patterns",
    "skill:prisma-schema-patterns"
  ],
  "allowedDomains": ["backend", "devops"],
  "reportTemplate": "execution-report-v1",
  "learning": {
    "enabled": false,
    "mode": "report-only"
  },
  "resourceLimits": {
    "maxDurationMs": 1800000,
    "maxTokens": 100000,
    "maxToolCalls": 50
  },
  "metadata": {
    "createdBy": "severino-factory",
    "createdAt": "2026-10-10T00:00:00.000Z",
    "skillKits": ["01-engenharia/backend-dev-kit"],
    "primaryLanguage": "typescript",
    "framework": "fastify"
  }
}