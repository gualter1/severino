# 9router Model Router — pegue em: dashboard 9router → API Keys
NINEROUTER_API_KEY=sk-COLE_SUA_CHAVE_AQUI
NINEROUTER_BASE_URL=https://api.9router.com/v1
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Telegram — fale com @BotFather no Telegram → /newbot
TELEGRAM_BOT_TOKEN=123456789:COLE_SEU_TOKEN_AQUI

# WhatsApp — pasta local, criada sozinha no primeiro QR scan
WHATSAPP_SESSION_PATH=./whatsapp-session

# Server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Storage
ROOMS_DIR=./rooms
TEMPLATES_DIR=../templates
