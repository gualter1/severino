{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "paths": {
      "*": ["./*"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "curated-contexts/**/*"]
}