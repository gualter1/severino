{
  "name": "@severino/mcp-v2-client",
  "version": "1.0.0",
  "description": "MCP v2 Client — Connect to other agents",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b && tsc -b tsconfig.esm.json",
    "dev": "tsc -b -w",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@severino/mcp-v2-core": "workspace:*",
    "@severino/mcp-v2-transport-websocket": "workspace:*",
    "@severino/mcp-v2-transport-stdio": "workspace:*",
    "@severino/mcp-v2-resilience": "workspace:*",
    "@severino/mcp-v2-crypto": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "@vitest/coverage-v8": "^1.4.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^7.3.0",
    "@typescript-eslint/eslint-plugin": "^7.3.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}