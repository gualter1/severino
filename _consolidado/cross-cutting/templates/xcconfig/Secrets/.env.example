# =============================================================================
# .env.example – Template versionado de secrets (NUNCA commitar o .env real)
# Copie para `.env` e preencha: `cp Secrets/.env.example Secrets/.env`
# Depois rode: `npm run generate-secrets`
# =============================================================================

# Apple Developer
DEVELOPMENT_TEAM_ID=ABCDE12345
PROVISIONING_PROFILE=
PROVISIONING_PROFILE_RELEASE=

# API
API_KEY=replace-me
ANALYTICS_API_KEY=replace-me

# Feature Flags / Remote Config (LaunchDarkly, Firebase)
LAUNCHDARKLY_SDK_KEY=replace-me
FIREBASE_API_KEY=replace-me

# Cert Pinning (SPKI hashes, base64)
CERT_PIN_PRIMARY=replace-me
CERT_PIN_BACKUP=replace-me

# Signing (CI – nunca commitar valores reais)
MATCH_PASSWORD=replace-me
APP_STORE_CONNECT_KEY_ID=replace-me
APP_STORE_CONNECT_ISSUER_ID=replace-me
