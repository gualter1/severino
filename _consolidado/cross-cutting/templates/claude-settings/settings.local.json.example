{
  "permissions": {
    "allow": [
      "Bash(*personal-script*)"
    ]
  },
  "env": {
    "GITHUB_TOKEN": "${GITHUB_TOKEN}",
    "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${OPENAI_API_KEY}"
  },
  "mcpServers": {
    "personal": { "command": "npx", "args": ["-y", "personal-mcp-server"] }
  }
}