{
  "name": "lowercase-hyphen-name",
  "version": "1.0.0",
  "description": "One-line description",
  "main": "SKILL.md",
  "type": "module",
  "scripts": {
    "review": "skill-review --config skill-review.yaml",
    "eval": "bash eval/harness.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:v1": "OPENCODE_MOCK=true OPENCODE_VERSION=v1 vitest run",
    "test:v2": "OPENCODE_MOCK=true OPENCODE_VERSION=v2 vitest run",
    "check:zero-deps": "npm ls --prod --parseable 2>/dev/null | grep -v '^$' | wc -l | xargs test 0 -eq"
  },
  "keywords": ["opencode-skill", "claude-code", "cursor"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}