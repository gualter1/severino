{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCPv2Message",
  "type": "object",
  "required": ["protocolVersion", "id", "type", "senderId"],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": ["DISCOVERY", "INVOKE", "STREAM", "RESPONSE", "ERROR", "HEARTBEAT"]
    },
    "senderId": {
      "type": "string"
    },
    "targetId": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
